rules_version = '2';
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in person can read and write only their own data; nobody else can see it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
